[Unit]
Description=WB OPS Netdata Docker Agent
Requires=docker.service
Requires=netdata-dbus-bus.service netdata-dbus-status.service
After=docker.service network-online.target netdata-dbus-status.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=NETDATA_ROOT=/var/lib/wb-ops-netdata/current
Environment=NETDATA_HOST_PORT=19999
Environment=NETDATA_NETWORK=wb-ops-netdata-prod
Environment=NETDATA_STATSD_HOST_PORT=8125
Environment=NETDATA_OTLP_HOST_PORT=4317
Environment=NETDATA_MEMORY_LIMIT=768m
Environment=NETDATA_DBUS_GID=987
ExecStartPre=/usr/bin/test -f /var/lib/wb-ops-netdata/current/etc/netdata.conf
ExecStart=/usr/bin/docker compose -f /opt/wb-ops/deploy/docker/netdata.compose.yml -f /opt/wb-ops/deploy/docker/netdata.listeners.compose.yml -p wb-ops-netdata up -d --no-build --pull never --wait --wait-timeout 70
ExecStop=/usr/bin/docker compose -f /opt/wb-ops/deploy/docker/netdata.compose.yml -f /opt/wb-ops/deploy/docker/netdata.listeners.compose.yml -p wb-ops-netdata down
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
