#!/bin/bash
# Запуск SSH-туннеля к WB OPS. Оставьте это окно открытым.
echo 'Подключение к WB OPS...'
echo 'После подключения откройте в браузере: http://127.0.0.1:8080'
echo 'Чтобы отключиться, нажмите Ctrl+C или закройте окно.'
ssh -p 443 -N -o ExitOnForwardFailure=yes -L 8080:127.0.0.1:80 mac@185.149.145.12
result=$?
if [ "$result" -ne 0 ]; then
  echo "Подключение завершилось с ошибкой (код $result)."
  read -r -p 'Нажмите Enter, чтобы закрыть окно.'
fi
