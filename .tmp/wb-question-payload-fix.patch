+    async def _confirm_question_answer(self, item_id: str, text: str) -> None:
+        """A successful PATCH alone does not prove that WB stored the answer."""
+        normalize = lambda value: " ".join(value.split()) if isinstance(value, str) else ""
+        expected = normalize(text)
+        try:
+            async with httpx.AsyncClient(base_url=self.base_url, headers={"Authorization": self.token}, timeout=15) as client:
+                for _ in range(3):
+                    # Share the WB category limit with PATCH and allow propagation.
+                    await asyncio.sleep(0.4)
+                    response = await client.get("/api/v1/question", params={"id": item_id})
+                    if response.status_code != 200:
+                        break
+                    payload = response.json()
+                    if not isinstance(payload, dict) or payload.get("error") is not False:
+                        break
+                    data = payload.get("data")
+                    if not isinstance(data, dict) or str(data.get("id")) != item_id:
+                        break
+                    answer = data.get("answer")
+                    if (data.get("state") == "wbRu" and isinstance(answer, dict)
+                            and normalize(answer.get("text")) == expected):
+                        return
+        except (httpx.RequestError, ValueError):
+            pass
+        raise WBDeliveryUncertain("WB не подтвердил сохранение ответа на вопрос. Проверьте ответ в личном кабинете; повторная отправка заблокирована.")
 
